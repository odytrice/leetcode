<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)shared/TestSupport.cs" Link="TestSupport.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)shared/Models.cs" Link="Models.cs" />
  </ItemGroup>
</Project>
